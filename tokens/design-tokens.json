  "text": {
    "brand": {
      "dust": {
        "$type": "string",
        "$value": "ĐUST",
        "$description": "Brand spelling of the Flovatar utility token in all prose, headlines, UI, social copy, alt text and prompts.",
        "$extensions": {
          "codepoint": "U+0110",
          "html": "&#272;",
          "not": [
            "DUST (in prose)",
            "$DUST (in prose)",
            "ÐUST (U+00D0 Eth)"
          ],
          "identifiers-keep-ascii": [
            "FlovatarDustToken",
            "DUST (token symbol in code/wallets)",
            "URLs, file names, hashtags",
            "quotes of historical posts"
          ],
          "glyph-coverage": {
            "Korolev Condensed Bold": true,
            "Korolev Compressed Bold": true,
            "Staatliches": "latin-ext subset only (the latin subset lacks U+0110)",
            "Roboto Condensed": "latin-ext subset only (the latin subset lacks U+0110)"
          },
          "fallback": "Load the latin-ext subset with unicode-range; otherwise set the Đ in Korolev Compressed/Condensed Bold, then Arial Narrow/Arial (guide §10.4)."
        }
      },
      "umbrella-line": {
        "$type": "string",
        "$value": "Your creativity powers the Megaverse. Again.",
        "$description": "Relaunch umbrella line. Use verbatim.",
        "$extensions": {}
      }
    }
  }
